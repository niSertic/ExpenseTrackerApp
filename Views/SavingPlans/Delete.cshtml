@model ExpenseTrackerApp.Models.SavingPlan

@{
    ViewData["Title"] = "Delete";
    var currency = Configuration["AppSettings:CurrencySymbol"] ?? "€";
}

<h1>Delete Saving Plan</h1>

<h4 class="text-danger">Are you sure you want to delete this saving plan?</h4>
<div class="mt-3">
    <dl class="row">
        <dt class="col-sm-3">Period</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd") – @Model.EndDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Monthly Income</dt>
        <dd class="col-sm-9">@Model.ExpectedMonthlyIncome.ToString("N2") @currency</dd>

        <dt class="col-sm-3">Monthly Savings Goal</dt>
        <dd class="col-sm-9">
            @(Model.PlannedMonthlySavings.HasValue
                        ? Model.PlannedMonthlySavings.Value.ToString("N2") + " " + currency
                        : "-")
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
