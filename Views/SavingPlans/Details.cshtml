@model ExpenseTrackerApp.Models.SavingPlan

@{
    ViewData["Title"] = "Details";
    var currency = Configuration["AppSettings:CurrencySymbol"] ?? "€";
}

<h1>Saving Plan</h1>

<div class="mt-3">
 
    <dl class="row">
        <dt class="col-sm-3">Period</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd") – @Model.EndDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Expected monthly income</dt>
        <dd class="col-sm-9">@Model.ExpectedMonthlyIncome.ToString("N2") @currency</dd>

        <dt class="col-sm-3">Planned monthly savings</dt>
        <dd class="col-sm-9">
            @(Model.PlannedMonthlySavings.HasValue
                        ? Model.PlannedMonthlySavings.Value.ToString("N2") + " " + currency
                        : "-")
        </dd>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@Model.Notes</dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
