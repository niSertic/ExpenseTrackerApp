@model ExpenseTrackerApp.Models.ViewModels.SavingPlanDashboardVM
@using ExpenseTrackerApp.Models.ViewModels

@{
    ViewData["Title"] = "Saving Plan Dashboard";
    var currency = Configuration["AppSettings:CurrencySymbol"] ?? "€";

    var plan = Model.Plan;

    DateTime effectiveEnd = Model.EffectiveEnd;
    int monthsElapsed = Model.MonthsElapsed;

    decimal incomeToDate = Model.IncomeToDate;
    decimal spentToDate = Model.SpentToDate;
    decimal savingsToDate = Model.SavingsToDate;

    decimal? goalToDate = Model.GoalToDate;
    decimal? progressPercent = Model.ProgressPercent;

    var monthlyRows = Model.MonthlyRows ?? new List<SavingPlanMonthRowVM>();
}

<h1>Saving Plan Dashboard</h1>

<div class="mb-3">
    <div class="text-muted">
        Plan period:
        <strong>@plan.StartDate.ToString("yyyy-MM-dd")</strong> –
        <strong>@plan.EndDate.ToString("yyyy-MM-dd")</strong>
        <br />
        Tracking to date (through <strong>@effectiveEnd.ToString("yyyy-MM-dd")</strong>)
        · Months elapsed: <strong>@monthsElapsed</strong>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted">Income (to date)</div>
            <div class="fs-4 fw-semibold">@incomeToDate.ToString("N2") @currency</div>
            <div class="text-muted">(@plan.ExpectedMonthlyIncome.ToString("N2") @currency / month)</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted">Spent (to date)</div>
            <div class="fs-4 fw-semibold">@spentToDate.ToString("N2") @currency</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted">Estimated savings (to date)</div>
            <div class="fs-4 fw-semibold @(savingsToDate >= 0 ? "text-success" : "text-danger")">
                @savingsToDate.ToString("N2") @currency
            </div>

            @if (plan.PlannedMonthlySavings.HasValue)
            {
                <div class="text-muted">
                    Goal: @plan.PlannedMonthlySavings.Value.ToString("N2") @currency / month
                </div>
            }
        </div>
    </div>
</div>

@if (plan.PlannedMonthlySavings.HasValue)
{
    <h4>Goal Progress (to date)</h4>

    @if (monthsElapsed <= 0)
    {
        <div class="alert alert-info">
            This plan hasn't started yet, so there is no progress to calculate.
        </div>
    }
    else if (!goalToDate.HasValue || goalToDate.Value <= 0)
    {
        <div class="alert alert-info">
            Savings goal is set but is 0 for the elapsed period.
        </div>
    }
    else
    {
        var pct = progressPercent ?? 0m;
        var barWidth = Math.Min(pct, 100m);

        <div class="mb-2">
            <strong>Goal (to date):</strong> @goalToDate.Value.ToString("N2") @currency
        </div>

        <div class="mb-2">
            <strong>Progress:</strong> @pct.ToString("0.#")%
            @if (pct > 100m)
            {
                <span class="text-muted">(above goal)</span>
            }
        </div>

        <div class="progress mb-3" style="height: 18px;">
            <div class="progress-bar" role="progressbar"
                 style="width: @barWidth%"
                 aria-valuenow="@barWidth" aria-valuemin="0" aria-valuemax="100">
            </div>
        </div>

        @if (savingsToDate >= goalToDate.Value)
        {
            <div class="alert alert-success">
                <strong>Nice!</strong> You are above your goal by
                @( (savingsToDate - goalToDate.Value).ToString("N2") ) @currency.
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <strong>Remaining to goal:</strong>
                @( (goalToDate.Value - savingsToDate).ToString("N2") ) @currency.
            </div>
        }
    }
}

@if (monthlyRows.Any())
{
    <h4 class="mt-4">Monthly Breakdown</h4>

    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Month</th>
                <th class="text-end">Income</th>
                <th class="text-end">Spent</th>
                <th class="text-end">Savings</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in monthlyRows)
            {
                var monthName = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetMonthName(r.Month);
                <tr>
                    <td>@monthName @r.Year</td>
                    <td class="text-end">@r.Income.ToString("N2") @currency</td>
                    <td class="text-end">@r.Spent.ToString("N2") @currency</td>
                    <td class="text-end @(r.Savings >= 0 ? "text-success" : "text-danger")">
                        @r.Savings.ToString("N2") @currency
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-semibold">
                <td>Total</td>
                <td class="text-end">@monthlyRows.Sum(x => x.Income).ToString("N2") @currency</td>
                <td class="text-end">@monthlyRows.Sum(x => x.Spent).ToString("N2") @currency</td>
                <td class="text-end @(monthlyRows.Sum(x => x.Savings) >= 0 ? "text-success" : "text-danger")">
                    @monthlyRows.Sum(x => x.Savings).ToString("N2") @currency
                </td>
            </tr>
        </tfoot>
    </table>
}

        @if (!string.IsNullOrWhiteSpace(plan.Notes))
        {
            <h4>Notes</h4>
            <p>@plan.Notes</p>
            
        }

<div class="mt-3 d-flex justify-content-left gap-2">
    <a asp-action="Edit" asp-route-id="@plan?.Id" class="btn btn-outline-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
