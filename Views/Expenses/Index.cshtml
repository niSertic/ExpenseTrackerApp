@using System.Text.Json
@using ExpenseTrackerApp.Models
@using ExpenseTrackerApp.Models.ViewModels
@model ExpenseTrackerApp.Models.ViewModels.ExpensesIndexVM

@{
    ViewData["Title"] = "Expenses";

    var years = Model.Years ?? new List<int>();
    var categories = Model.Categories ?? new List<Category>();

    var selectedYear = Model.Filters.Year;
    var selectedMonth = Model.Filters.Month;
    var selectedCategoryId = Model.Filters.CategoryId;

    string from = Model.Filters.From?.ToString("yyyy-MM-dd") ?? "";
    string to = Model.Filters.To?.ToString("yyyy-MM-dd") ?? "";

    decimal total = Model.TotalAmount;
    int count = Model.ExpenseCount;
    decimal average = Model.AverageAmount;

    var categorySummary = Model.CategorySummary ?? new List<CategorySummaryVM>();

    var chartLabelsJson = JsonSerializer.Serialize(Model.ChartLabels ?? new List<string>());
    var chartValuesJson = JsonSerializer.Serialize(Model.ChartValues ?? new List<decimal>());

    var trendLabelsJson = JsonSerializer.Serialize(Model.TrendLabels ?? new List<string>());
    var trendValuesJson = JsonSerializer.Serialize(Model.TrendValues ?? new List<decimal>());


    var currency = Configuration["AppSettings:CurrencySymbol"] ?? "€";

    var page = Model.Page;
    var pageSize = Model.PageSize;
    var totalPages = Model.TotalPages;
    var sort = Model.Filters.Sort ?? "date_desc";

    string fromRoute = Model.Filters.From?.ToString("yyyy-MM-dd") ?? "";
    string toRoute = Model.Filters.To?.ToString("yyyy-MM-dd") ?? "";

	// Get selected category name
    string? selectedCategoryName = null;

    if (selectedCategoryId.HasValue)
    {
        selectedCategoryName = categories
        .FirstOrDefault(c => c.Id == selectedCategoryId.Value)
        ?.Name;
	}
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Expenses</h1>
    <a asp-action="Create" class="btn btn-success">+ New Expense</a>
</div>

<!-- Filter form -->
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-1">
        <label class="form-label">Year</label>
        <select name="year" class="form-select">
            <option value="">All</option>
            @foreach (var y in years)
            {
                <option value="@y" selected="@(selectedYear == y)">@y</option>
            }
        </select>
    </div>

    <div class="col-md-1">
        <label class="form-label">Month</label>
        <select name="month" class="form-select">
            <option value="">All</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(selectedMonth == m)">
                    @System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetMonthName(m)
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Category</label>
        <select name="categoryId" class="form-select">
            <option value="">All</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(selectedCategoryId == c.Id)">
                    @c.Name
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="@from" />
    </div>

    <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="@to" />
    </div>

	<!-- Preserve sorting and pagination state -->
    <input type="hidden" name="sort" value="@sort" />
    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="pageSize" value="@pageSize" />

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<!-- Total amount for the selected period -->
<div class="col-12 col-md-4 col-lg-2">
    <div class="border rounded p-1 h-100">
        <div class="text-muted fs-6">Total spent</div>
        <div class="fs-5 fw-semibold">
            @total.ToString("N2") @currency
        </div>
    </div>
</div>

<!-- Stats when category is selected-->
@if (selectedCategoryId.HasValue && selectedCategoryName != null)
{
    
    <hr />
    <div class="fw-semibold fs-5 align-items-center">
        @selectedCategoryName category stats:
    </div>
    <br /> 
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-4 col-lg-2">
            <div class="border rounded p-1 h-100">
                <div class="text-muted fs-6">
                    Number of expenses
                </div>
                <div class="fw-semibold">
                    @count
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4 col-lg-2">
            <div class="border rounded p-1 h-100">
                <div class="text-muted fs-6">
                    Average amount
                </div>
                <div class="fw-semibold">
                    @average.ToString("N2") @currency
                </div>
            </div>
        </div>
    </div>
}

<hr />
<!-- Category summary and pie chart -->
@if (!Model.Filters.CategoryId.HasValue && categorySummary.Any())
{
    <div class="row g-3 align-items-start mb-3">
        <div class="col-12 col-lg-7">

            <h4>Summary by Category</h4>

            <table class="table table-sm table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Total Amount</th>
                        <th>Share (%)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in categorySummary)
                    {
                        <tr>
                            <td>@s.CategoryName</td>
                            <td>@s.TotalAmount.ToString("N2") @currency</td>
                            <td>@s.Percentage.ToString("0.##") %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-12 col-lg-5">
            <h4 class="mb-2">Spending Chart</h4>

            <div class="border rounded p-2" style="max-width: 360px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
}

<!-- Monthly trend chart-->
@if ((Model.TrendLabels?.Any() ?? false) && (Model.TrendValues?.Any() ?? false))
{
    <div class="mb-3">
        <button class="btn btn-outline-primary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#trendCollapse"
                aria-expanded="false"
                aria-controls="trendCollapse">
            Show Monthly Trend Chart
        </button>
    </div>

    <div class="collapse mb-3" id="trendCollapse">
        <div class="border rounded p-2" style="max-width: 900px; height: 260px;">
            <canvas id="trendChart"></canvas>
        </div>
    </div>
}

<!-- Active saving plan badge-->
@if (Model.ActivePlan != null)
{
    var p = Model.ActivePlan;

    <div class="alert alert-success d-flex justify-content-between align-items-start fs-6">
        <div>
            <div class="fw-semibold">Active Saving Plan</div>
            <div class="text-muted">
                @p.StartDate.ToString("dd.MM.yyyy") – @p.EndDate.ToString("dd.MM.yyyy")
                (to date through @p.EffectiveEnd.ToString("dd.MM.yyyy"))
            </div>

            <div class="mt-2">
                <strong>Savings to date:</strong> @p.SavingsToDate.ToString("N2") @currency

                @if (p.GoalToDate.HasValue && p.GoalToDate.Value > 0)
                {
                    <span class="ms-2">
                        | <strong>Goal remaining:</strong>
                       
                        @if (p.GoalRemaining <= 0)
                        {
                            <span class="text-success">Goal achieved!</span>
                        }
                        else
                        {
                            <span>
                                @((p.GoalRemaining ?? 0m).ToString("N2")) @currency
                            </span>
                        }
                    </span>
                }
            </div>
        </div>

        <div class="text-end">
            <a asp-controller="SavingPlans" asp-action="Details" asp-route-id="@p.PlanId"
               class="btn btn-sm btn-outline-success">
                View Dashboard
            </a>
        </div>
    </div>
}


<hr />


<p>
    <a asp-action="Create" class="btn btn-success">+ New Expense</a>
</p>

<!-- Expenses table -->
<table class="table table-striped">
    <thead>
        <tr>
            
            <th>
                <a asp-action="Index"
                   asp-route-year="@Model.Filters.Year"
                   asp-route-month="@Model.Filters.Month"
                   asp-route-from="@fromRoute"
                   asp-route-to="@toRoute"
                   asp-route-categoryId="@Model.Filters.CategoryId"
                   asp-route-page="1"
                   asp-route-pageSize="@pageSize"
                   asp-route-sort="@(sort == "date_asc" ? "date_desc" : "date_asc")"
                   class="text-decoration-none">
                    Date @(sort == "date_asc" ? "▲" : sort == "date_desc" ? "▼" : "")
                </a>
            </th>

            <th>
                Category
            </th>

            <th>
                <a asp-action="Index"
                   asp-route-year="@Model.Filters.Year"
                   asp-route-month="@Model.Filters.Month"
                   asp-route-from="@fromRoute"
                   asp-route-to="@toRoute"
                   asp-route-categoryId="@Model.Filters.CategoryId"
                   asp-route-page="1"
                   asp-route-pageSize="@pageSize"
                   asp-route-sort="@(sort == "amount_asc" ? "amount_desc" : "amount_asc")"
                   class="text-decoration-none">
                    Amount @(sort == "amount_asc" ? "▲" : sort == "amount_desc" ? "▼" : "")
                </a>
            </th>

            <th>
               Description
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Expenses) {
        <tr>
            
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @item.Amount.ToString("N2") @currency
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
                <td class="text-end">
                    <div class="d-inline-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary action-btn">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger action-btn">Delete</a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav aria-label="Expenses pages" class="mt-3">
        <ul class="pagination">

            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-year="@Model.Filters.Year"
                   asp-route-month="@Model.Filters.Month"
                   asp-route-from="@fromRoute"
                   asp-route-to="@toRoute"
                   asp-route-categoryId="@Model.Filters.CategoryId"
                   asp-route-sort="@sort"
                   asp-route-page="@(page - 1)"
                   asp-route-pageSize="@pageSize">
                    Prev
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-year="@Model.Filters.Year"
                       asp-route-month="@Model.Filters.Month"
                       asp-route-from="@fromRoute"
                       asp-route-to="@toRoute"
                       asp-route-categoryId="@Model.Filters.CategoryId"
                       asp-route-sort="@sort"
                       asp-route-page="@p"
                       asp-route-pageSize="@pageSize">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-year="@Model.Filters.Year"
                   asp-route-month="@Model.Filters.Month"
                   asp-route-from="@fromRoute"
                   asp-route-to="@toRoute"
                   asp-route-categoryId="@Model.Filters.CategoryId"
                   asp-route-sort="@sort"
                   asp-route-page="@(page + 1)"
                   asp-route-pageSize="@pageSize">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}

@section Scripts {
    <script>
        (function () {
            const currency = @Html.Raw(JsonSerializer.Serialize(currency));

            // Pie chart 
            const pieCanvas = document.getElementById('categoryChart');
            if (pieCanvas) {
                const labels = @Html.Raw(chartLabelsJson);
                const values = @Html.Raw(chartValuesJson);

                new Chart(pieCanvas, {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{ data: values }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const value = ctx.raw ?? 0;
                                        return `${ctx.label}: ${value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${currency}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Trend chart
            let trendChartInstance = null;

            function buildTrendChart() {
                const trendCanvas = document.getElementById('trendChart');
                if (!trendCanvas) return;

                
                if (trendChartInstance) {
                    trendChartInstance.resize();
                    return;
                }

                const tLabels = @Html.Raw(trendLabelsJson);
                const tValues = @Html.Raw(trendValuesJson);

                trendChartInstance = new Chart(trendCanvas, {
                    type: 'line',
                    data: {
                        labels: tLabels,
                        datasets: [{
                            data: tValues,
                            tension: 0.25
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const v = ctx.raw ?? 0;
                                        return `${v.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${currency}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            
            const trendCollapse = document.getElementById('trendCollapse');
            if (trendCollapse) {
                trendCollapse.addEventListener('shown.bs.collapse', buildTrendChart);
            } else {
                
                buildTrendChart();
            }
        })();
	</script>

}