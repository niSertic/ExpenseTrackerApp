@using System.Text.Json
@using ExpenseTrackerApp.Models
@using ExpenseTrackerApp.Models.ViewModels
@model ExpenseTrackerApp.Models.ViewModels.ExpensesIndexVM

@{
    ViewData["Title"] = "Expenses";

    var years = Model.Years ?? new List<int>();
    var categories = Model.Categories ?? new List<Category>();

    var selectedYear = Model.Filters.Year;
    var selectedMonth = Model.Filters.Month;
    var selectedCategoryId = Model.Filters.CategoryId;

    string from = Model.Filters.From?.ToString("yyyy-MM-dd") ?? "";
    string to = Model.Filters.To?.ToString("yyyy-MM-dd") ?? "";

    decimal total = Model.TotalAmount;
    int count = Model.ExpenseCount;
    decimal average = Model.AverageAmount;

    var categorySummary = Model.CategorySummary ?? new List<CategorySummaryVM>();

    var chartLabelsJson = JsonSerializer.Serialize(Model.ChartLabels ?? new List<string>());
    var chartValuesJson = JsonSerializer.Serialize(Model.ChartValues ?? new List<decimal>());

    var trendLabelsJson = JsonSerializer.Serialize(Model.TrendLabels ?? new List<string>());
    var trendValuesJson = JsonSerializer.Serialize(Model.TrendValues ?? new List<decimal>());


    var currency = Configuration["AppSettings:CurrencySymbol"] ?? "€";
}

<h1>Expenses</h1>

<!-- Filter form -->
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-1">
        <label class="form-label">Year</label>
        <select name="year" class="form-select">
            <option value="">All</option>
            @foreach (var y in years)
            {
                <option value="@y" selected="@(selectedYear == y)">@y</option>
            }
        </select>
    </div>

    <div class="col-md-1">
        <label class="form-label">Month</label>
        <select name="month" class="form-select">
            <option value="">All</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(selectedMonth == m)">
                    @System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetMonthName(m)
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Category</label>
        <select name="categoryId" class="form-select">
            <option value="">All</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(selectedCategoryId == c.Id)">
                    @c.Name
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="@from" />
    </div>

    <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="@to" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<!-- Active saving plan badge-->
@if (Model.ActivePlan != null)
{
    var p = Model.ActivePlan;

    <div class="alert alert-success d-flex justify-content-between align-items-start">
        <div>
            <div class="fw-semibold">Active Saving Plan</div>
            <div class="text-muted">
                @p.StartDate.ToString("yyyy-MM-dd") – @p.EndDate.ToString("yyyy-MM-dd")
                (to date through @p.EffectiveEnd.ToString("yyyy-MM-dd"))
            </div>

            <div class="mt-2">
                <strong>Savings to date:</strong> @p.SavingsToDate.ToString("N2") @currency

                @if (p.GoalToDate.HasValue && p.GoalToDate.Value > 0)
                {
                    <span class="ms-2">
                        | <strong>Goal remaining:</strong>
                       
                        @if (p.GoalRemaining <= 0)
                        {
                            <span class="text-success">Goal achieved!</span>
                        }
                        else
                        {
                            <span>
                                @((p.GoalRemaining ?? 0m).ToString("N2")) @currency
                            </span>
                        }
                    </span>
                }
            </div>
        </div>

        <div class="text-end">
            <a asp-controller="SavingPlans" asp-action="Details" asp-route-id="@p.PlanId"
               class="btn btn-sm btn-outline-success">
                View Dashboard
            </a>
        </div>
    </div>
}

<!-- Total amount for the selected period -->
<div class="mb-3">
	<strong>Total for selected period:</strong> @total.ToString("N2") @currency
</div>

<!-- Stats when category is selected-->
@if (selectedCategoryId.HasValue)
{
    <div class="mb-3">
        <strong>Stats for selected category:  </strong>
        Number of expenses: @count  |
		Average amount: @average.ToString("N2") @currency 
	</div>
}

<!-- Monthly trend chart-->
@if ((Model.TrendLabels?.Any() ?? false) && (Model.TrendValues?.Any() ?? false))
{
    <div class="mb-3">
        <button class="btn btn-outline-primary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#trendCollapse"
                aria-expanded="false"
                aria-controls="trendCollapse">
            Show Monthly Trend Chart
        </button>
    </div>

    <div class="collapse mb-3" id="trendCollapse">
        <div class="border rounded p-2" style="max-width: 900px; height: 260px;">
            <canvas id="trendChart"></canvas>
        </div>
    </div>
}

<!-- Category summary and pie chart -->
@if (!Model.Filters.CategoryId.HasValue && categorySummary.Any())
{
    <div class="row g-3 align-items-start mb-3">
        <div class="col-12 col-lg-7">

            <h4>Summary by Category</h4>

            <table class="table table-sm table-bordered mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Total Amount</th>
                        <th>Share (%)</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in categorySummary)
                {
                    <tr>
                        <td>@s.CategoryName</td>
                        <td>@s.TotalAmount.ToString("N2") @currency</td>
                        <td>@s.Percentage.ToString("0.##") %</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="col-12 col-lg-5">
            <h4 class="mb-2">Spending Chart</h4>

            <div class="border rounded p-2" style="max-width: 360px;">
                <canvas id="categoryChart"></canvas>
            </div>
		</div>
	</div>
}

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<!-- Expenses table -->
<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Expenses) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @item.Amount.ToString("N2") @currency
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        (function () {
            const currency = @Html.Raw(JsonSerializer.Serialize(currency));

            // Pie chart 
            const pieCanvas = document.getElementById('categoryChart');
            if (pieCanvas) {
                const labels = @Html.Raw(chartLabelsJson);
                const values = @Html.Raw(chartValuesJson);

                new Chart(pieCanvas, {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{ data: values }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const value = ctx.raw ?? 0;
                                        return `${ctx.label}: ${value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${currency}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Trend chart
            let trendChartInstance = null;

            function buildTrendChart() {
                const trendCanvas = document.getElementById('trendChart');
                if (!trendCanvas) return;

                
                if (trendChartInstance) {
                    trendChartInstance.resize();
                    return;
                }

                const tLabels = @Html.Raw(trendLabelsJson);
                const tValues = @Html.Raw(trendValuesJson);

                trendChartInstance = new Chart(trendCanvas, {
                    type: 'line',
                    data: {
                        labels: tLabels,
                        datasets: [{
                            data: tValues,
                            tension: 0.25
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const v = ctx.raw ?? 0;
                                        return `${v.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${currency}`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            
            const trendCollapse = document.getElementById('trendCollapse');
            if (trendCollapse) {
                trendCollapse.addEventListener('shown.bs.collapse', buildTrendChart);
            } else {
                
                buildTrendChart();
            }
        })();
	</script>

}